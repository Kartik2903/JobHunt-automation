  "components": {
    "schemas": {
      "ApplyRequest": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id",
            "description": "Unique identifier for the job (e.g. greenhouse:slug:123)"
          },
          "url": {
            "type": "string",
            "title": "Url",
            "description": "Application or job posting URL"
          },
          "cover_letter": {
            "type": "string",
            "title": "Cover Letter",
            "description": "Tailored cover note drafted by LLM",
            "default": ""
          },
          "dry_run": {
            "type": "boolean",
            "title": "Dry Run",
            "description": "When true, validates form data without final dispatch",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "url"
        ],
        "title": "ApplyRequest"
      },
      "ApplyResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "dry_run": {
            "type": "boolean",
            "title": "Dry Run"
          },
          "target": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target"
          },
          "endpoint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Endpoint"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "fields": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fields"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "success",
          "dry_run"
        ],
        "title": "ApplyResponse"
      },
      "EmailNotifyRequest": {
        "properties": {
          "subject": {
            "type": "string",
            "title": "Subject",
            "description": "Subject line for email",
            "default": "🦞 JobHunt Digest: Filtered Opportunities"
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "Markdown or text content of the digest"
          },
          "to_email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "To Email",
            "description": "Recipient email (defaults to MAIL_TO from .env)"
          }
        },
        "type": "object",
        "required": [
          "content"
        ],
        "title": "EmailNotifyRequest"
      },
      "EmailNotifyResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "success"
        ],
        "title": "EmailNotifyResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
