        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id",
            "description": "Unique job ID e.g. linkedin:123 or greenhouse:stripe:456"
          },
          "ats": {
            "type": "string",
            "title": "Ats",
            "description": "Source platform or ATS name"
          },
          "company": {
