                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Comma-separated company slugs e.g. stripe,figma,postman,levelai,linear. If empty, uses configured companies",
              "title": "Companies"
            },
            "description": "Comma-separated company slugs e.g. stripe,figma,postman,levelai,linear. If empty, uses configured companies"
          },
