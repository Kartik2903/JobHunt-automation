LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDERS=mistral,cerebras,sambanova,groq
GEMINI_API_KEY=paste-your-gemini-api-key-here
SCREEN_MODEL=gemini-3.6-flash
DRAFT_MODEL=gemini-3.6-flash
PROFILE_MODEL=gemini-3.6-flash

# Fallback provider credentials. Leave blank to skip that provider.
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
GROQ_API_KEY=

# Optional provider-specific model overrides; defaults are built in.
# MISTRAL_SCREEN_MODEL=mistral-small-latest
# MISTRAL_DRAFT_MODEL=mistral-large-latest
# CEREBRAS_SCREEN_MODEL=qwen-3.8-27b
# CEREBRAS_DRAFT_MODEL=qwen-3.8-27b
# SAMBANOVA_SCREEN_MODEL=Meta-Llama-3.3-70B-Instruct
# SAMBANOVA_DRAFT_MODEL=Meta-Llama-3.3-70B-Instruct

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_TO=your-email@gmail.com
